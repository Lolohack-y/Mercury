PORT=3840
# Пароль входа учителя. Без него нейросеть, загрузка учебников и ключ недоступны.
TEACHER_PASSWORD=
# Сколько запросов к нейросети в сутки на весь сервер. Гости её не вызывают.
AI_DAILY_LIMIT=8
# gigachat или yandex (Алиса / YandexGPT). Ключ лежит только на сервере, гости его не вводят.
AI_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Пусто — сервер сам выберет модель, доступную ключу (обычно GigaChat-2).
GIGACHAT_MODEL=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Бот в MAX (платформа для партнёров, business.max.ru). Без токена мини-приложение всё равно открывается в браузере: /max/
MAX_BOT_TOKEN=
# Публичный https-адрес сервера, например https://xxxx.trycloudflare.com (мини-приложение: <адрес>/max/)
WEBAPP_URL=
# Необязательно: бот в Telegram, тот же сервер
BOT_TOKEN=
