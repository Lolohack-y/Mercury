PORT=3840
# gigachat или yandex (Алиса / YandexGPT). Ключ можно вписать и в форме «Нейросеть» на сайте.
AI_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Бот @BotFather. Без токена мини-приложение всё равно открывается в браузере: /tg/
BOT_TOKEN=
# Публичный https-адрес мини-приложения, например https://xxxx.trycloudflare.com/tg
WEBAPP_URL=
